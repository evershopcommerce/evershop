# Copy to .env in this folder and adjust if your dev server / DB differ.
# The suite uses the LIVE dev DB (per design — core maintenance focus, not a
# pristine isolated DB). Cleanup is the responsibility of each test.

# Base URL of the running EverShop instance. User must `npm run dev` from
# /Users/thenguyenhuu/vscode/evershop/core before invoking the suite.
BASE_URL=http://localhost:3000

# Postgres connection string. Used for:
#   - Creating + tearing down the test admin user.
#   - Cleaning up widget_instance rows whose name starts with `e2e-`.
#   - DB-level assertions inside specs (changeset_operation, widget_placement).
DATABASE_URL=postgres://root@localhost:5432/evershop

# Number of Playwright workers. e2e tests share the same DB, so parallelism
# is limited unless tests are written with strict per-test isolation.
# Start with 1; bump to 2-3 once we've validated isolation patterns.
PLAYWRIGHT_WORKERS=1

# --- Cloud file storage (admin/specs/fileStorage) -------------------------
# Optional. Without credentials the cloud storage suites SKIP. These hit a
# REAL bucket/container — use disposable ones (each run leaves a zero-byte
# folder-marker object behind; there is no folder-delete API).
#
# S3 / S3-compatible (Hetzner, R2, MinIO, Spaces):
# E2E_S3_BUCKET=
# E2E_S3_REGION=
# E2E_S3_ACCESS_KEY_ID=
# E2E_S3_SECRET_ACCESS_KEY=
# E2E_S3_ENDPOINT=              # e.g. https://fsn1.your-objectstorage.com
# E2E_S3_FORCE_PATH_STYLE=      # 1 for MinIO
# E2E_S3_BASE_URL=              # optional CDN
# E2E_S3_PUBLIC_READ=           # 1 when objects are anonymously readable —
#                               # also asserts the /images proxy allowlist
#
# Azure Blob Storage:
# E2E_AZURE_CONNECTION_STRING=
# E2E_AZURE_CONTAINER=          # defaults to "images"
# E2E_AZURE_PUBLIC_READ=        # 1 requires AllowBlobPublicAccess on the account
#
# Google Cloud Storage:
# E2E_GCS_BUCKET=
# E2E_GCS_SERVICE_ACCOUNT_KEY=  # the key file JSON as one line (or empty for ADC)
# E2E_GCS_BASE_URL=             # optional CDN
# E2E_GCS_PUBLIC_READ=          # 1 when allUsers has Storage Object Viewer
